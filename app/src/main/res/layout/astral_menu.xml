<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F20A0A0A">

    <LinearLayout android:id="@+id/header"
        android:layout_width="match_parent" android:layout_height="42dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/astral_header_bg"
        android:paddingStart="10dp" android:paddingEnd="10dp">
        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="●"
            android:textColor="#FFFFFFFF" android:textSize="12sp"
            android:layout_marginEnd="6dp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="astral|t.me/astraldlc7|0.1.0"
            android:textColor="#FFFFFFFF" android:textSize="11sp"/>
        <TextView android:id="@+id/btnClose"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="✕" android:textColor="#FFFFFFFF"
            android:textSize="18sp" android:padding="6dp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:paddingTop="10dp" android:paddingStart="8dp"
        android:paddingEnd="8dp" android:paddingBottom="6dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:layout_marginEnd="4dp">
            <TextView android:layout_width="match_parent"
                android:layout_height="30dp" android:text="Functions"
                android:gravity="center" android:textColor="#FFEDEDED"
                android:textSize="12sp" android:background="#1AFFFFFF"/>
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="40dp" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingStart="6dp"
                android:paddingEnd="2dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="China Hat"
                    android:textColor="#FFEDEDED" android:textSize="12sp"/>
                <CheckBox android:id="@+id/cbChinaHat"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:buttonTint="#FFD32F2F"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="40dp" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingStart="6dp"
                android:paddingEnd="2dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Растяг 4:3"
                    android:textColor="#FFEDEDED" android:textSize="12sp"/>
                <CheckBox android:id="@+id/cbStretch"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:buttonTint="#FFD32F2F"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="40dp" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingStart="6dp"
                android:paddingEnd="2dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Скрыть"
                    android:textColor="#FFEDEDED" android:textSize="12sp"/>
                <TextView android:id="@+id/btnHide"
                    android:layout_width="wrap_content" android:layout_height="28dp"
                    android:text="X" android:textColor="#FFD32F2F"
                    android:textSize="12sp" android:gravity="center"
                    android:paddingStart="10dp" android:paddingEnd="10dp"
                    android:background="#1AD32F2F"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:layout_marginStart="4dp">
            <TextView android:layout_width="match_parent"
                android:layout_height="30dp" android:text="Optimization"
                android:gravity="center" android:textColor="#FFEDEDED"
                android:textSize="12sp" android:background="#1AFFFFFF"/>
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="40dp" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingStart="6dp"
                android:paddingEnd="2dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="120 FPS"
                    android:textColor="#FFEDEDED" android:textSize="12sp"/>
                <CheckBox android:id="@+id/cbFps"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:buttonTint="#FFD32F2F"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="40dp" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingStart="6dp"
                android:paddingEnd="2dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Сверхплавно"
                    android:textColor="#FFEDEDED" android:textSize="12sp"/>
                <CheckBox android:id="@+id/cbSmooth"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:buttonTint="#FFD32F2F"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="40dp" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingStart="6dp"
                android:paddingEnd="2dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="No Lag"
                    android:textColor="#FFEDEDED" android:textSize="12sp"/>
                <CheckBox android:id="@+id/cbNoLag"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:buttonTint="#FFD32F2F"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="v0.1.0 beta" android:textColor="#80FFFFFF"
        android:textSize="10sp" android:gravity="end"
        android:paddingEnd="10dp" android:paddingBottom="4dp"/>

    <LinearLayout android:layout_width="match_parent"
        android:layout_height="46dp" android:orientation="horizontal"
        android:background="#FF0A0A0A">
        <TextView android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:text="🌙" android:textSize="18sp"
            android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:text="💀" android:textSize="18sp"
            android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:text="👁" android:textSize="18sp"
            android:gravity="center" android:background="#1AD32F2F"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:text="☀" android:textSize="18sp"
            android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:text="🍃" android:textSize="18sp"
            android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:text="📁" android:textSize="18sp"
            android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:text="⚙" android:textSize="18sp"
            android:gravity="center"/>
    </LinearLayout>
</LinearLayout>
